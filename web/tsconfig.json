{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "config/**/*.ts",
    "data/**/*.ts",
    "pages/**/*.ts",
    "locators/**/*.ts",
    "steps/**/*.ts",
    "support/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "evidence"
  ]
}
