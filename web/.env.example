# Configuración opcional para las cuentas PÚBLICAS de la demo.
# Copiar a .env solo si necesitas cambiar valores. .env no se versiona.
WEB_BASE_URL=https://www.saucedemo.com
WEB_USERNAME=standard_user
WEB_PASSWORD=secret_sauce
WEB_LOCKED_USERNAME=locked_out_user
BROWSER=chromium
HEADLESS=true
STEP_TIMEOUT_MS=45000
EXPECT_TIMEOUT_MS=10000
CUCUMBER_WORKERS=2


# Regla esperada de negocio; no se deduce del impuesto mostrado por la aplicación.
WEB_TAX_RATE_PERCENT=8
